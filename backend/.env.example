# Copy to backend/.env and fill in. Never commit the real .env.

# Sarvam AI - https://dashboard.sarvam.ai (sent only from the backend as `api-subscription-key`)
SARVAM_API_KEY=

# Comma-separated hosts that may resolve to private/loopback IPs (local dev + demo target)
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
